# =========================================================
# 嵌入式项目 .gitignore
# 适用：Keil MDK + STM32CubeMX + VSCode + JLink
# =========================================================

# ---------- Keil MDK 编译产物 ----------
Objects/
Listings/
DebugConfig/
RTE/
*.o
*.axf
*.elf
*.bin
*.hex
*.map
*.lst
*.crf
*.d
*.dep
*.lnp
*.htm
*.build_log.htm
*.iex
*.sct
*.bak
*.ddk
*.edk
*.obj
*.plg
*.opt
*.scvd
*.dbgconf

# Keil 个人配置与 GUI 布局（建议忽略）
*.uvguix.*
*.uvoptx

# 以下工程文件建议提交，不要忽略
# *.uvprojx
# *.uvproj
# *.ioc
# *.mxproject

# ---------- JLink / 调试器日志 ----------
JLinkLog.txt
JLinkSettings.ini
*.log
*.jlink
*.trace

# ---------- STM32CubeMX 生成目录 ----------
Debug/
Release/
build/
Build/
Output/

# CubeMX 备份文件
*.mxproject.bak
*.ioc.bak

# ---------- VSCode ----------
.vscode/*
!.vscode/settings.json
!.vscode/c_cpp_properties.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时文件 ----------
*~
*.tmp
*.swp
*.swo

# ---------- 密钥与个人配置 ----------
secrets.h
*.pem
*.key
*.cert
wifi_config.h

# ---------- 其他 IDE ----------
.idea/
*.launch
*.sav